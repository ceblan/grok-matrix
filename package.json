{
  "name": "matrix-cursor",
  "private": true,
  "type": "module",
  "description": "Bridge Cursor Agent SDK / Grok to a self-hosted Matrix homeserver",
  "scripts": {
    "check": "tsc --noEmit",
    "dev": "agent-sdk dev --port 43123",
    "serve": "agent-sdk serve --dir . --mode single --dev --port 43123",
    "mock:matrix": "node scripts/mock-matrix-server.mjs",
    "test:wake": "node scripts/wake-selftest.mjs",
    "validate": "agent-sdk validate --dir ."
  },
  "dependencies": {
    "@grok/agent-sdk": "^0.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "6.0.3"
  }
}
