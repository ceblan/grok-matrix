# Cursor model turns (local serve / run)
# CURSOR_API_KEY=

# Matrix homeserver (self-hosted Synapse / Dendrite / Conduit / …)
MATRIX_HOMESERVER_URL=https://matrix.example.com
MATRIX_ACCESS_TOKEN=
# Optional; discovered via whoami when omitted
MATRIX_USER_ID=@cursorbot:example.com

# Wake rules
MATRIX_WAKE_ON_MENTION=true
MATRIX_WAKE_ON_DM=true
MATRIX_WAKE_ON_PREFIX=true
MATRIX_COMMAND_PREFIX=!cursor
# Comma-separated room ids. Empty = every joined room.
# MATRIX_ROOM_ALLOWLIST=!roomId:example.com

# Shared secret for POST /v1/channels/matrix/inbound (appservice / relay)
MATRIX_WEBHOOK_SECRET=change-me

# Sync long-poll timeout (ms)
MATRIX_SYNC_TIMEOUT_MS=30000

# --- Local mock homeserver (scripts/mock-matrix-server.mjs) ---
# MATRIX_HOMESERVER_URL=http://127.0.0.1:18765
# MATRIX_ACCESS_TOKEN=syt_mock_bot_token
# MATRIX_USER_ID=@cursorbot:localhost
# MATRIX_WEBHOOK_SECRET=dev-secret
